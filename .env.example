# Copy to .env.local for local development. Defaults point at the local
# Supabase started with `supabase start`; `supabase status` prints the key.
# Live values go in .env.production.local (used by `npm run build`/`npm start`,
# overrides .env.local) and in Vercel's environment settings. Never here.

# Supabase project URL and publishable key (sb_publishable_…). Both are safe
# in the browser; Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site URL used for canonical links, sitemap and social images.
NEXT_PUBLIC_APP_URL=https://pitchype.com

# Server-only. Supabase secret key (sb_secret_…), used only to store profile
# photos (src/lib/storage.ts) and record which one is current. It bypasses row
# level security: never give it a NEXT_PUBLIC_ name, never log it.
# Local: `supabase status` prints it. Live: Supabase dashboard → API keys.
SUPABASE_SECRET_KEY=

# Server-only. Protects the scheduled job that lapses unpaid approvals
# (/api/cron/expire-engagements). Vercel Cron sends it automatically when set
# in the project; any other scheduler sends `Authorization: Bearer <value>`.
# Generate one with `openssl rand -hex 32`.
CRON_SECRET=

# Server-only. Keys the visitor hash for tracked-link clicks (pay per click,
# src/app/r/[code]); raw IPs are never stored. Without it links still redirect
# but no click is recorded. Generate one with `openssl rand -hex 32`, and don't
# change it while a campaign is running (repeat visits would count again).
CLICK_HASH_SECRET=

# Server-only. Paystack secret key; test keys start sk_test_. Never give it a
# NEXT_PUBLIC_ name. Used for checkout, payment and transfer verification,
# webhook signatures and payouts (src/lib/paystack.ts). Live: Paystack
# dashboard -> Settings -> API keys.
PAYSTACK_SECRET_KEY=

# Server-only. Resend API key (re_…) for notification emails
# (src/lib/resend.ts). Never give it a NEXT_PUBLIC_ name, never log it.
# Live: Resend dashboard -> API Keys.
RESEND_API_KEY=

# Server-only. The sender of notification emails, on a domain verified in
# Resend, e.g. Pitchype <hello@pitchype.com>.
FROM_EMAIL=

# Optional. Error reports to PostHog (src/lib/observability.ts, src/instrumentation.ts).
# Leave POSTHOG_PROJECT_API_KEY empty to send nothing (local development).
# The project key is the one starting phc_ (not a personal API key). Host:
# https://us.i.posthog.com or https://eu.i.posthog.com, matching the project's region.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=

# --- Dojah (identity checks: NIN + selfie widget, CAC lookup, AML screening) ---
# Not used while identity checks are switched off (the MVP default; /admin/identity).
# Leave these empty until then; the switch refuses to turn on without them.
# https://sandbox.dojah.io while testing, https://api.dojah.io in production.
DOJAH_BASE_URL=
DOJAH_APP_ID=
# Secret key, server only. Sent as-is in the Authorization header (no "Bearer").
DOJAH_SECRET_KEY=
# Public key. Safe for the browser; the page passes it to the widget as a prop.
DOJAH_PUBLIC_KEY=
# Secret of the webhook subscription for the kyc_widget service (not the API secret key).
DOJAH_WEBHOOK_SECRET=
# Widget id of the hosted flow built in the Dojah dashboard (NIN + liveness selfie).
DOJAH_WIDGET_ID_NIN=
# 32 random bytes, base64 (openssl rand -base64 32). Keys the fingerprints of NIN numbers
# (src/lib/identity-crypto.ts). Losing it restarts duplicate-ID detection: keep a copy per environment.
IDENTITY_FINGERPRINT_KEY=
