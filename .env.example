# Copy to .env.local for local development. Defaults point at the local
# Supabase started with `supabase start`; `supabase status` prints the key.
# Live values go in .env.production.local (used by `npm run build`/`npm start`,
# overrides .env.local) and in Vercel's environment settings. Never here.

# Supabase project URL and publishable key (sb_publishable_…). Both are safe
# in the browser; Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site URL used for canonical links, sitemap and social images.
NEXT_PUBLIC_APP_URL=https://www.pitchype.com

# Server-only. Supabase secret key (sb_secret_…), used only to store profile
# photos (src/lib/storage.ts) and record which one is current. It bypasses row
# level security: never give it a NEXT_PUBLIC_ name, never log it.
# Local: `supabase status` prints it. Live: Supabase dashboard → API keys.
SUPABASE_SECRET_KEY=

# Server-only. Protects the scheduled job that lapses unpaid approvals
# (/api/cron/expire-engagements). Vercel Cron sends it automatically when set
# in the project; any other scheduler sends `Authorization: Bearer <value>`.
# Generate one with `openssl rand -hex 32`.
CRON_SECRET=
