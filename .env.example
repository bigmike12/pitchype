# Copy to .env.local for local development. Defaults point at the local
# Supabase started with `supabase start`; `supabase status` prints the key.
# Hosted (production) values belong in Vercel's environment settings, never here.

# Supabase project URL and publishable key (sb_publishable_…). Both are safe
# in the browser; Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site URL used for canonical links, sitemap and social images.
NEXT_PUBLIC_APP_URL=https://www.pitchype.com
