# Copy to .env.local and fill in. Names only here; never commit values.
# For local development, `supabase status` prints the URL and anon key.

# Supabase project URL and anon (public) key. Both are safe in the browser;
# Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL used for canonical links, sitemap and social images,
# e.g. https://pitchype.com in production.
NEXT_PUBLIC_APP_URL=
